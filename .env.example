# Copy this file to .env and fill in values from your own Firebase project:
# Firebase console -> Project settings -> General -> "Your apps" -> Web app config.
# .env is already in .gitignore - never commit real keys.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side only (used by server/index.js via firebase-admin, NOT
# exposed to the browser - do not prefix with VITE_).
# Path to a service account JSON key file, downloaded from:
# Firebase console -> Project settings -> Service accounts -> Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=c:\Yashwanth\WorkSetup\NodeJS\serviceAccountKey.json

